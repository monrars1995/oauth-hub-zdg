# ─────────────────────────────────────────────────────────────────────────────
# NeuroHub Meta by @goldneuron.io — exemplo de configuração
#
# Copie para `.env` e preencha. TODOS os valores de credencial podem, em vez
# disso, ser informados pelo painel em /  (aba "Configuração do App").
# O painel grava em data/settings.json e tem PRIORIDADE sobre estas variáveis.
# Nenhuma credencial é embutida no código — este projeto nasce vazio.
# ─────────────────────────────────────────────────────────────────────────────

# Porta HTTP (padrão: 3300)
PORT=3300

# URL pública deste hub, SEM barra no final.
# É a base usada nos redirect_uri do OAuth e na URL de webhook mostrada no painel.
# Em produção, HTTPS é obrigatório. Ex.: https://apphub.seudominio.com
PUBLIC_URL=http://localhost:3300

# Nome de marca exibido no painel (whitelabel). Vazio = "NeuroHub Meta".
BRAND_NAME=NeuroHub Meta

# URL do código-fonte (link "Source" no rodapé do painel). A AGPL-3.0 §13 exige
# que usuários que interagem remotamente possam obter o código. Vazio = padrão
# https://github.com/monrars1995/oauth-hub-zdg.
SOURCE_URL=https://github.com/monrars1995/oauth-hub-zdg

# ─── Segurança ───────────────────────────────────────────────────────────────

# Segredo HMAC usado para assinar o "state" do OAuth e os cookies de sessão do
# painel. Gere com: openssl rand -hex 32. Obrigatório em produção (mín. 32 chars).
SESSION_SECRET=
# Alternativa para Docker/Kubernetes Secrets (o valor direto acima tem prioridade):
# SESSION_SECRET_FILE=/run/secrets/session_secret

# Chave separada para criptografar App Secrets, Verify Tokens e access tokens em
# data/*.json com AES-256-GCM. Gere com: openssl rand -hex 32. Obrigatória em
# produção. Em dev sem env, copie o conteúdo de data/.data-encryption-key para
# esta variável antes de promover o mesmo volume. Não altere a chave de dados existentes.
DATA_ENCRYPTION_KEY=
# DATA_ENCRYPTION_KEY_FILE=/run/secrets/data_encryption_key

# Senha do painel admin. Se vazia, o painel abre SEM autenticação apenas em dev.
# Obrigatória em produção (mín. 12 chars); o processo se recusa a iniciar sem ela.
ADMIN_PASSWORD=
# ADMIN_PASSWORD_FILE=/run/secrets/admin_password

# Origins adicionais permitidas no navegador, separadas por vírgula. A própria
# origin de PUBLIC_URL já é permitida. Chamadas server-to-server sem Origin passam.
CORS_ALLOWED_ORIGINS=

# ─── Multi-app ───────────────────────────────────────────────────────────────
# Este hub gerencia VÁRIOS apps Meta pelo painel (aba "Apps"), cada um com suas
# credenciais, URL de webhook (/webhook/app/<id>) e destinos de encaminhamento.
#
# As variáveis META_* abaixo são OPCIONAIS: servem apenas para "semear" UM app
# automaticamente no primeiro boot (deploys headless) — só rodam se META_APP_ID
# estiver preenchido E ainda não existir nenhum app. Depois disso, gerencie tudo
# pelo painel. O App Secret NUNCA é exposto ao navegador.

# Versão padrão da Graph API usada ao criar apps.
META_API_VERSION=v25.0

# Timeout (ms) ao encaminhar webhooks para os destinos. Padrão: 10000.
FORWARD_TIMEOUT_MS=10000

# Hosts de encaminhamento permitidos, separados por vírgula. Vazio permite hosts
# públicos, mas localhost, redes privadas/link-local/reservadas, redirects e DNS
# rebinding são bloqueados. Em produção, use uma allowlist explícita sempre que possível.
FORWARD_ALLOWED_HOSTS=

# Permitir destinos HTTP apenas em desenvolvimento. Produção exige HTTPS.
ALLOW_INSECURE_FORWARD_URLS=false

# --- Seed opcional de um app no primeiro boot ---
META_APP_NAME=App principal
META_APP_ID=
META_APP_SECRET=
META_WABA_CONFIG_ID=
META_MESSENGER_CONFIG_ID=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
WEBHOOK_VERIFY_TOKEN=

# ─── Webhook ─────────────────────────────────────────────────────────────────

# Quantidade máxima de eventos de webhook mantidos em memória/disco (ring).
# Padrão: 500.
WEBHOOK_EVENTS_MAX=500

# Logar no console cada webhook recebido (1/true/yes/on). Padrão: off.
WEBHOOK_DEBUG_LOG=
